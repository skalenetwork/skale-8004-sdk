{
  "name": "@skalenetwork/8004-skale-x402-proxy",
  "version": "0.1.0",
  "description": "Client helper for ERC-8004 x402 SKALE proxy relayer calls",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@skalenetwork/8004": "workspace:*",
    "viem": "^2.38.5"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  }
}
